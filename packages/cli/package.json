{
  "name": "@clewmap/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clewmap/core": "workspace:*",
    "@clewmap/indexer": "workspace:*",
    "@clewmap/mcp": "workspace:*",
    "@clewmap/summarizer": "workspace:*",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1"
  },
  "bin": {
    "clewmap": "./dist/bin.js"
  }
}
